[Unit]
Description=Streamio Media Server
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/streamio
EnvironmentFile=/home/pi/streamio/.env
ExecStart=/usr/bin/node server/dist/index.js
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
