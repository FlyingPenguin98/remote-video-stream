PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# External drive paths
MEDIA_ROOT=/mnt/external/media
DATA_DIR=/mnt/external/streamio-data

# System ffmpeg binaries
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Auth — change this before deploying!
JWT_SECRET=change-this-to-a-long-random-string-at-least-32-characters
JWT_EXPIRY=7d

# Get a free API key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_v3_api_key_here
TMDB_BASE_URL=https://api.themoviedb.org/3

# Transcoding limits
MAX_CONCURRENT_SESSIONS=2
SESSION_TIMEOUT_MS=300000
HLS_SEGMENT_DURATION=6
MAX_VIDEO_BITRATE=4000k
MAX_RESOLUTION=720

# Library auto-scan schedule (cron syntax)
SCAN_CRON=0 */2 * * *
